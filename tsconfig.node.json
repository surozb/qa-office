{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "composite": true, "types": ["node"], "outDir": "out/tsc-node"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/floor/layout.ts", "test/**/*", "electron.vite.config.ts", "vitest.config.ts"]
}
